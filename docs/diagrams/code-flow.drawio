<mxfile host="drawio-by-hand"><diagram id="p1" name="code-flow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageWidth="1700" pageHeight="1090" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;font style=&quot;font-size:24px&quot;&gt;&lt;b&gt;GCP Analytics RAG: how the code works&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#555555&quot;&gt;Three small packages: ingestion writes the index, retrieval reads it, evaluation measures it&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1500" height="60" as="geometry"/></mxCell><mxCell id="g_ing" value="Ingestion  ·  src/rag/ingestion, embed.py, store.py" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#eef7ee;strokeColor=#82b366;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="1640" height="330" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;parse.convert_corpus&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;PDF → Markdown with pymupdf4llm; .md files are copied; hidden folders are skipped&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="270" height="110" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;pipeline.ingest&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;hash = chunker settings + text; unchanged files are skipped; files that disappeared are removed&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="400" y="150" width="270" height="110" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;SemanticChunker.chunk&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;embeds the sentences, cuts at the top 10% distance, 440 tokens at most, and at a # header after 100 tokens&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="740" y="150" width="270" height="110" as="geometry"/></mxCell><mxCell id="a4" value="&lt;b&gt;Embedder.embed(kind=passage)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;bge-m3 int8 ONNX on CPU, 4 threads, batches of 16: one vector per chunk&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="1080" y="150" width="270" height="110" as="geometry"/></mxCell><mxCell id="a5" value="&lt;b&gt;store.replace_document&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;swaps all the chunks of one file in one transaction&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="1420" y="150" width="220" height="110" as="geometry"/></mxCell><mxCell id="a6" value="&lt;b&gt;store.get_hashes / delete_documents&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;what is already indexed, and what is gone&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="400" y="300" width="270" height="90" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;dashed=1;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="a2" target="a6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;dashed=1;exitX=0.7;exitY=0;entryX=0.7;entryY=1;" edge="1" parent="1" source="a6" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g_ret" value="Retrieval  ·  src/rag/retrieval, embed.py, store.py" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#eef7ee;strokeColor=#82b366;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="1640" height="400" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;HybridRetriever.search_many&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;queries = the question and its translation; k = 30 chunks; 100 candidates per search&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="270" height="120" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;HybridRetriever.search&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;runs once per phrasing: one vector leg and one keyword leg&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="400" y="540" width="270" height="120" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;Embedder.embed(kind=query)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;the query becomes 1024 numbers&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="740" y="520" width="270" height="80" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;store.vector_search&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;PostgreSQL: cosine distance on the halfvec column through the HNSW index (ef_search 100)&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="1080" y="520" width="290" height="100" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;store.keyword_search&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;PostgreSQL: only words found in under 5% of the chunks, ranked with ts_rank_cd (not BM25)&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="1080" y="650" width="290" height="110" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b&gt;fusion.rrf&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;score = 1 / (60 + position), summed over the lists&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="1430" y="580" width="210" height="110" as="geometry"/></mxCell><mxCell id="b7" value="&lt;b&gt;fusion.rrf again&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;merges the lists of the phrasings and keeps the best 30&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="740" width="270" height="100" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.4;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="b2" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="b4" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="one list per phrasing" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g_eval" value="Evaluation  ·  src/rag/evaluation" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#666666;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="910" width="1640" height="150" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;golden.load_golden&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;questions and the passages that answer them&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="960" width="360" height="70" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;metrics.evaluate&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;a question is answered if a top-k chunk contains its evidence; hit rate and MRR&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="520" y="960" width="520" height="70" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;report.run&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;runs a set of questions and prints the table&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="1140" y="960" width="400" height="70" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>