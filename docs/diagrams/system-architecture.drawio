<mxfile host="drawio-by-hand"><diagram id="p1" name="system-architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageWidth="1700" pageHeight="880" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;font style=&quot;font-size:24px&quot;&gt;&lt;b&gt;GCP Analytics RAG: how the pieces connect&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#555555&quot;&gt;From the question in Claude Code to the vectors in PostgreSQL, and how the index was built and published&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1500" height="60" as="geometry"/></mxCell><mxCell id="g_client" value="Client" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fffbe9;strokeColor=#d6b656;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="300" height="330" as="geometry"/></mxCell><mxCell id="user" value="&lt;b&gt;You&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ask a question about the course&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="240" height="60" as="geometry"/></mxCell><mxCell id="claude" value="&lt;b&gt;Claude Code / OpenCode&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;the model writes the translation, calls the tool and answers from the chunks it gets back, citing the source file&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="240" width="240" height="130" as="geometry"/></mxCell><mxCell id="g_mcp" value="MCP server  ·  repo GCP-ANALYTICS_RAG_MCP" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#eef4fd;strokeColor=#6c8ebf;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="90" width="360" height="330" as="geometry"/></mxCell><mxCell id="fast" value="&lt;b&gt;gcp_rag_mcp (FastMCP)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;python process started by the client, talks over stdio&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="430" y="140" width="300" height="50" as="geometry"/></mxCell><mxCell id="tool_search" value="&lt;b&gt;gcp_rag_search_course&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;question + translation + k  →  the best chunks (rank, source, headers, text) over stdio&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="430" y="210" width="300" height="70" as="geometry"/></mxCell><mxCell id="tool_check" value="&lt;b&gt;gcp_rag_check_setup&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;are the model files and the database ready? and where to get what is missing&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="430" y="300" width="300" height="70" as="geometry"/></mxCell><mxCell id="g_rag" value="RAG library  ·  repo GCP-ANALYTICS_RAG" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#eef7ee;strokeColor=#82b366;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="830" y="90" width="380" height="330" as="geometry"/></mxCell><mxCell id="hybrid" value="&lt;b&gt;HybridRetriever.search_many&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;per phrasing: vector search + keyword search, fused with RRF; then the phrasings fused again&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="860" y="140" width="320" height="80" as="geometry"/></mxCell><mxCell id="embed" value="&lt;b&gt;bge-m3 (int8 ONNX)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;local on CPU, 4 threads: the query becomes 1024 numbers&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="860" y="240" width="320" height="70" as="geometry"/></mxCell><mxCell id="store" value="&lt;b&gt;store.py&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;the only module that talks to the database&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="860" y="330" width="320" height="60" as="geometry"/></mxCell><mxCell id="g_db" value="Database  ·  container rag-db" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f4eef7;strokeColor=#9673a6;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1280" y="90" width="380" height="330" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;PostgreSQL 17 + pgvector&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;database courses_bge&lt;br&gt;417 documents (GCP 310, Power BI 107), 1,728 chunks&lt;br&gt;&lt;br&gt;table chunks:&lt;br&gt;halfvec(1024) with an HNSW index (meaning)&lt;br&gt;tsvector with a GIN index (exact words)&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="1310" y="140" width="320" height="230" as="geometry"/></mxCell><mxCell id="e1" value="question" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="claude"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;entryX=0;entryY=0.3;" edge="1" parent="1" source="claude" target="tool_search"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="chunks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2e7d32;fontSize=11;fontColor=#2e7d32;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" edge="1" parent="1" source="tool_search" target="claude"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="search" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="tool_search" target="hybrid"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="hybrid" target="embed"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="hybrid" target="store"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="store" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g_build" value="Building the index  ·  once, on the author&#x27;s machine" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fdeeed;strokeColor=#b85450;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="1180" height="380" as="geometry"/></mxCell><mxCell id="src" value="&lt;b&gt;Course files&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;GCP: 310 Markdown and PDF&lt;br&gt;Power BI: 107 PDFs&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="530" width="190" height="100" as="geometry"/></mxCell><mxCell id="convert" value="&lt;b&gt;convert_corpus&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;PDF → Markdown with pymupdf4llm&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="290" y="530" width="200" height="100" as="geometry"/></mxCell><mxCell id="ocr" value="&lt;b&gt;OCR (RapidOCR)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;187 slide pages with no text layer; the text read is appended to the Markdown&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="290" y="680" width="200" height="100" as="geometry"/></mxCell><mxCell id="chunker" value="&lt;b&gt;SemanticChunker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;cuts where the meaning shifts, at 440 tokens, and at # headers&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="530" y="530" width="230" height="100" as="geometry"/></mxCell><mxCell id="embed2" value="&lt;b&gt;bge-m3&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;one vector per chunk&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="800" y="530" width="180" height="100" as="geometry"/></mxCell><mxCell id="ingest" value="&lt;b&gt;store&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;replace_document: chunks + vectors&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="1020" y="530" width="160" height="100" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="src" target="convert"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="convert" target="chunker"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;entryX=0.3;entryY=1;" edge="1" parent="1" source="ocr" target="chunker"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="slides" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="src" target="ocr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="chunker" target="embed2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#444444;fontSize=11;fontColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="embed2" target="ingest"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7b4f9d;fontSize=11;fontColor=#7b4f9d;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.2;entryY=1;" edge="1" parent="1" source="ingest" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g_pub" value="Publishing  ·  GitHub" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#666666;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1280" y="470" width="380" height="380" as="geometry"/></mxCell><mxCell id="dump" value="&lt;b&gt;pg_dump&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;infra/db/courses_bge.dump and courses_e5.dump&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="1310" y="530" width="320" height="80" as="geometry"/></mxCell><mxCell id="actions" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;publish-index-images.yml: builds, starts and checks each image&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="1310" y="640" width="320" height="80" as="geometry"/></mxCell><mxCell id="ghcr" value="&lt;b&gt;ghcr.io/estvn/gcp-rag-db&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;tags :bge-m3 and :e5-small, public; podman run restores the index (dashed arrow)&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=2;fontSize=13;shadow=1;" vertex="1" parent="1"><mxGeometry x="1310" y="750" width="320" height="80" as="geometry"/></mxCell><mxCell id="e15" value="dump" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="db" target="dump"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dump" target="actions"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="actions" target="ghcr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#666666;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;entryX=1;entryY=0.7;" edge="1" parent="1" source="ghcr" target="db"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>